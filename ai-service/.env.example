# ==============================================================
# InterviewPrep AI - Python FastAPI Microservice Configuration
# ==============================================================

# Server configuration
APP_NAME="InterviewPrep AI Microservice"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# AI Provider Selection: "mock" (transparent rule-based engine) or "gemini"
AI_PROVIDER="mock"

# Demo Mode Flag (True forces transparent deterministic evaluator)
DEMO_MODE=true

# Google Gemini API configuration (Optional - required only if AI_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI Configuration (Optional extension)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"
